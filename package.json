{
  "name": "seaglass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --import tsx --import ./scripts/node-assets.mjs scripts/og-pages.ts && node --import tsx --import ./scripts/node-assets.mjs scripts/journal-pages.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx --import ./scripts/node-assets.mjs scripts/sim-check.ts",
    "check:fast": "node scripts/checks.mjs fast",
    "check:slow": "node scripts/checks.mjs slow",
    "check:list": "node scripts/checks.mjs all --list",
    "check:browser": "node scripts/worlds-browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.1",
    "nosleep.js": "^0.12.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
